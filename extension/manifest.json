{
  "manifest_version": 3,
  "name": "Tab Sorter",
  "version": "1.1.0",
  "description": "Sort tabs, group GitHub repositories, keep favorite sites on the right, and save Markdown snapshots.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "downloads",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Sorter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
